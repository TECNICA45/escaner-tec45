<!DOCTYPE html>
<html lang="es">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Psicopedagógica TEC45</title>

<script src="https://unpkg.com/html5-qrcode"></script>

<style>

body{
font-family:Arial;
text-align:center;
background:#f2f5f8;
padding:20px;
}

.card{
background:white;
border-radius:15px;
padding:20px;
max-width:450px;
margin:auto;
box-shadow:0 4px 15px #aaa;
}

h1{
color:#17365d;
}

#lector{
width:100%;
margin:auto;
}

button{
background:#17365d;
color:white;
border:0;
padding:15px;
border-radius:10px;
font-size:16px;
width:100%;
margin-top:15px;
}

</style>

</head>


<body>


<div class="card">

<h1>📋 PSICOPEDAGÓGICA 45</h1>

<p>
Escuela Secundaria Técnica No. 45
</p>

<div id="lector"></div>


<p id="mensaje"></p>


</div>


<script>


function abrirPsicopedagogica(curp){

let enlace =
"https://script.google.com/macros/s/TU_ENLACE_APPS_SCRIPT/exec?curp="
+
encodeURIComponent(curp);


window.location.href = enlace;


}



function resultadoQR(texto){

document.getElementById("mensaje").innerHTML =
"Alumno detectado:<br>" + texto;


// Aquí manda la CURP al sistema

abrirPsicopedagogica(texto);


}



let scanner = new Html5QrcodeScanner(

"lector",

{
fps:10,
qrbox:250
}

);


scanner.render(

resultadoQR,

(error)=>{

}

);


</script>


</body>

</html>
